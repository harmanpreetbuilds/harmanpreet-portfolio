}

.ladewise-board .board-footnote {
  color: #8e9998;
  font-size: 13px;
  line-height: 1.5;
}

.ladewise-feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid rgba(24, 32, 31, .18);
  border-bottom: 1px solid rgba(24, 32, 31, .18);
}

.ladewise-feature-grid article {
  min-height: 200px;
  padding: 34px 26px;
  border-right: 1px solid rgba(24, 32, 31, .14);
}

.ladewise-feature-grid article:last-child {
  border-right: 0;
}

.ladewise-feature-grid article > span {
  color: #8b918e;
  font: 9px ui-monospace, SFMono-Regular, Menlo, monospace;
}

.ladewise-feature-grid h3 {
  margin: 28px 0 14px;
  font: 500 25px Georgia, serif;
}

.ladewise-feature-grid p {
  margin: 0;
  color: #68716e;
  font-size: 14px;
  line-height: 1.55;
}

.inside-ladewise {
  padding: 110px 0 100px;
}

.inside-ladewise-heading {
  display: grid;
  grid-template-columns: .55fr 1.2fr .65fr;
  gap: 60px;
  margin-bottom: 70px;
}

.inside-ladewise-heading h3 {
  font-size: clamp(46px, 5vw, 76px);
}

.ladewise-workflow,
.ladewise-proof {
  background: #f4f1e9;
  border: 1px solid #cbccc5;
  padding: 28px;
}

.ladewise-workflow-head {
  display: flex;
  justify-content: space-between;
  padding-bottom: 22px;
  border-bottom: 1px solid #d3d4cd;
}

.ladewise-workflow-head span,
.ladewise-stages span,
.ladewise-stages small,
.ladewise-register small {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.ladewise-workflow-head span {
  color: #848a87;
  font-size: 10px;
  letter-spacing: .12em;
}

.ladewise-workflow-head strong {
  font-size: 21px;
}

.ladewise-stages {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  gap: 14px;
  align-items: center;
  padding: 30px 0;
  border-bottom: 1px solid #d3d4cd;
}

.ladewise-stages article {
  min-height: 105px;
  padding: 18px;
  border: 1px solid #c4c8c3;
}

.ladewise-stages article.is-done {
  background: #d7ded8;
}

.ladewise-stages article.is-current {
  background: #e2e9e4;
  border-color: #4e6b61;
}

.ladewise-stages span,
.ladewise-stages small {
  display: block;
  color: #818885;
  font-size: 8px;
}

.ladewise-stages strong {
  display: block;
  margin: 12px 0;
}

.ladewise-stages b {
  color: #929795;
  font-weight: 400;
}

.ladewise-register {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.ladewise-register article {
  padding: 24px 20px 8px 0;
}

.ladewise-register article:not(:first-child) {
  border-left: 1px solid #d3d4cd;
  padding-left: 20px;
}

.ladewise-register span,
.ladewise-register small,
.ladewise-register strong {
  display: block;
}

.ladewise-register small {
  margin: 7px 0;
  color: #858b88;
  font-size: 8px;
}

.ladewise-register strong {
  color: #4e6b61;
  font-size: 12px;
}

.ladewise-proof-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 26px;
  margin-top: 26px;
}

.ladewise-proof-label {
  color: #848a87;
}

.ladewise-proof h4 {
  margin: 13px 0 26px;
  font: 500 26px Georgia, serif;
}

.ladewise-proof > p {
  color: #69716e;
  line-height: 1.55;
}

.ladewise-paper {
  width: 70%;
  min-height: 255px;
  margin: 0 auto 26px;
  padding: 25px;
  background: #fffdf7;
  border: 1px solid #d2d0c9;
}

.ladewise-paper > div:first-child {
  display: flex;
  justify-content: space-between;
  gap: 20px;
}

.ladewise-paper span {
  color: #8a8d88;
  font-size: 8px;
}

.ladewise-paper > i {
  display: block;
  height: 3px;
  margin-top: 24px;
  background: #d0d1cb;
}

.ladewise-paper > i.short {
  width: 52%;
  margin-top: 10px;
}

.ladewise-paper section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  margin-top: 30px;
}

.ladewise-paper section b {
  height: 70px;
  border: 1px solid #d8d8d2;
}

.ladewise-paper > small {
  display: block;
  margin-top: 25px;
  color: #93958f;
  font-size: 7px;
}

.ladewise-security {
  border-top: 1px solid #d3d4cd;
}

.ladewise-security > div {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 17px 0;
  border-bottom: 1px solid #d3d4cd;
}

.ladewise-security span {
  color: #888e8b;
  font-size: 9px;
  letter-spacing: .08em;
}

.ladewise-security strong {
  font-size: 13px;
}

.ladewise-engineering {
  display: grid;
  grid-template-columns: .72fr 1fr .58fr;
  gap: 80px;
  padding: 90px 0;
  border-top: 1px solid rgba(24, 32, 31, .18);
  border-bottom: 1px solid rgba(24, 32, 31, .18);
}

.ladewise-engineering h3 {
  margin-top: 28px;
  font-size: clamp(48px, 5vw, 72px);
}

.ladewise-engineering-copy {
  padding-top: 28px;
}

.ladewise-engineering-note {
  align-self: center;
  padding: 30px;
  background: #cbd8d1;
  transform: rotate(1.5deg);
}

.ladewise-engineering-note span {
  display: block;
  margin-bottom: 18px;
  font-size: 9px;
}

.ladewise-engineering-note strong {
  font: 600 27px/1 Georgia, serif;
}

.ladewise-case-stack {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  padding-top: 42px;
}

.ladewise-case-stack p {
  margin: 12px 0 0;
  color: #646d6a;
  font: 12px ui-monospace, SFMono-Regular, Menlo, monospace;
}

.ladewise-case-stack a {
  color: #18201f;
  padding-bottom: 8px;
  border-bottom: 1px solid #878c89;
  text-decoration: none;
}

@media (max-width: 900px) {
  .ladewise-case-study {
    padding: 76px 24px;
  }

  .ladewise-case-heading,
  .ladewise-case-layout,
  .inside-ladewise-heading,
  .ladewise-engineering {
    grid-template-columns: 1fr;
    gap: 38px;
  }

  .ladewise-feature-grid {
    grid-template-columns: 1fr 1fr;
  }

  .ladewise-stages {
    grid-template-columns: 1fr;
  }

  .ladewise-stages b {
    transform: rotate(90deg);
    text-align: center;
  }

  .ladewise-proof-pair {
    grid-template-columns: 1fr;
  }

  .ladewise-case-stack {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 620px) {
  .ladewise-case-heading h2 {
    font-size: 58px;
  }

  .ladewise-feature-grid,
  .ladewise-register {
    grid-template-columns: 1fr;
  }

  .ladewise-feature-grid article,
  .ladewise-register article,
  .ladewise-register article:not(:first-child) {
    border-right: 0;
    border-left: 0;
    border-bottom: 1px solid rgba(24, 32, 31, .14);
    padding-left: 0;
  }

  .ladewise-map {
    transform: scale(.78);
    transform-origin: center;
    width: 128%;
    margin-left: -14%;
  }

  .ladewise-paper {
    width: 100%;
  }
}


