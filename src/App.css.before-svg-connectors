  top: 9px;
}

.lw-map-review {
  left: 29%;
  bottom: 4px;
}

.lw-map-line {
  position: absolute;
  height: 1px;
  background: #617073;
  transform-origin: left center;
}

.lw-map-line-in {
  width: 34%;
  left: 15%;
  top: 225px;
}

.lw-map-line-db {
  width: 38%;
  left: 54%;
