    grid-template-columns: 1fr;

    min-height: auto;

    padding-top: 75px;
  }

  .hero-left {
    max-width: 720px;
  }

  .hero h1 {
    font-size: clamp(64px, 11vw, 88px);
  }

  .hero-collage {
    min-height: 570px;

    margin-top: 20px;
  }

  .marden-preview {
    right: 5%;

    width: 430px;
  }

  .note-one {
    left: 12%;
  }

  .sync-mini {
    left: 7%;
  }

  .section-heading {
    grid-template-columns: 1fr;

    gap: 20px;

    margin-bottom: 55px;
  }

  .section-side-copy {
    grid-column: auto;

