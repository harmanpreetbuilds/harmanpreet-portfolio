    gap: 70px;

    margin-top: 80px;
  }

  .marden-shot-developers,
  .marden-shot-login {
    margin-top: 0;
  }

  .marden-product-note {
    width: 80%;

    margin-top: 85px;
  }

  .engineering-spread {
    grid-template-columns: 1fr;

    gap: 34px;
  }

  .engineering-note {
    grid-column: auto;

    width: 60%;

    margin-left: auto;
  }

  .capabilities {
    grid-template-columns: 1fr;

    gap: 65px;

    padding:
      100px
      32px;
  }

  .capabilities-title h2 {
    max-width: 600px;
  }

  .about-section {
    width: calc(100% - 64px);

    grid-template-columns: 1fr;

    gap: 50px;

    padding:
      110px
      0;
  }
}


