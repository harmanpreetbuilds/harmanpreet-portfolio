.ladewise-case-study .case-label {
  color: #7b817e;
}

.ladewise-case-heading {
  display: grid;
  grid-template-columns: 1.35fr .65fr;
  gap: 100px;
  margin-top: 62px;
}

.ladewise-case-heading h2,
.ladewise-problem h3,
.inside-ladewise-heading h3,
.ladewise-engineering h3 {
  margin: 0;
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 500;
  line-height: .92;
  letter-spacing: -.055em;
}

.ladewise-case-heading h2 {
  font-size: clamp(64px, 7vw, 108px);
}

.ladewise-case-heading em,
.ladewise-problem em,
.inside-ladewise-heading em,
.ladewise-engineering em {
  color: #4e6b61;
  font-weight: 500;
}

.ladewise-case-intro span,
.ladewise-note span,
.ladewise-proof-label,
.ladewise-engineering-note span {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  letter-spacing: .12em;
}

.ladewise-case-intro span {
  color: #777e7b;
}

.ladewise-case-intro p,
.ladewise-problem p,
.inside-ladewise-heading > p:last-child,
.ladewise-engineering-copy p {
  color: #5e6764;
  font-size: 16px;
  line-height: 1.65;
}

.ladewise-case-layout {
  display: grid;
  grid-template-columns: .68fr 1.32fr;
  gap: 70px;
  padding: 80px 0;
}

.ladewise-problem h3 {
  margin: 28px 0 38px;
  font-size: clamp(44px, 4.2vw, 68px);
}

.ladewise-note {
  width: 240px;
  margin-top: 50px;
  padding: 26px;
  background: #cad7d0;
  transform: rotate(-2deg);
  box-shadow: 10px 12px 0 rgba(24, 32, 31, .08);
}

.ladewise-note span {
  display: block;
  margin-bottom: 14px;
  font-size: 8px;
}

.ladewise-note strong {
  font: 600 24px/1 Georgia, serif;
}

.ladewise-board {
  background: #182124;
  color: #eef0e9;
  padding: 28px 34px 30px;
}

.ladewise-board .board-caption {
  display: flex;
  justify-content: space-between;
  color: #899493;
  font: 9px ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .12em;
}

.ladewise-map {
  position: relative;
  height: 450px;
  margin-top: 20px;
}

.lw-map-node,
.lw-map-control {
  position: absolute;
  min-width: 115px;
  padding: 14px 16px;
  border: 1px solid #617073;
  background: #182124;
  z-index: 3;
}

.lw-map-node span,
.lw-map-control span {
  display: block;
  color: #778485;
  margin-bottom: 8px;
  font: 7px ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .09em;
}

.lw-map-node strong,
.lw-map-control strong {
  font-size: 13px;
}

.lw-map-web {
  left: 0;
  top: 190px;
}

.lw-map-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 146px;
  height: 146px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #d9e0d7;
  color: #18201f;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 4;
}

.lw-map-core small {
  color: #68726f;
  font: 6px ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .1em;
}

.lw-map-core strong {
  margin: 8px 0 3px;
  font: 500 42px/1 Georgia, serif;
}

.lw-map-core span {
  font: 12px Georgia, serif;
}

.lw-map-db {
  right: 0;
  top: 48px;
}

.lw-map-files {
