    height: 110px;

    font-size: 53px;
  }

  .marden-preview-bottom {
    right: 20px;
    bottom: 20px;
    left: 20px;
  }

  .marden-preview-bottom h2 {
    font-size: 32px;
  }

  .arrow-circle {
    width: 38px;
    height: 38px;
  }

  .note-one {
    top: 3px;
    left: auto;
    right: 0;

    width: 180px;

    padding: 17px;
  }

  .paper-note strong {
    font-size: 18px;
  }

  .sync-mini {
    left: 0;
    bottom: -15px;

    width: 135px;
