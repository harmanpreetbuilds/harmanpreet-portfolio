/* =========================================================
   HARMANPREET — PORTFOLIO
   Editorial engineering portfolio
   Exact match for the current App.jsx
   ========================================================= */

:root {
  --paper: #f3f0e7;
  --paper-deep: #ddd8cc;
  --ink: #171713;
  --muted: #5f5c55;
  --line: rgba(23, 23, 19, 0.16);

  --blue: #2d4de0;
  --yellow: #e7d971;
  --sage: #b9c3ae;
  --rust: #b04c37;

  --dark: #12170f;
  --dark-2: #0e120c;
  --dark-text: #eeebe1;
  --dark-muted: #a7aa9f;
  --dark-line: rgba(238, 235, 225, 0.18);

  --serif: "DM Serif Display", Georgia, serif;
  --sans: "Manrope", Arial, Helvetica, sans-serif;
  --mono: "DM Mono", monospace;
  --hand: "Caveat", cursive;

  --page: min(1440px, calc(100% - 120px));
}


/* =========================================================
   BASE
   ========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  overflow-x: hidden;

  color: var(--ink);
  background: var(--paper);

  font-family: var(--sans);
}

.portfolio {
  width: 100%;
  min-height: 100vh;

  overflow: hidden;
}

.portfolio a {
  color: inherit;
  text-decoration: none;
}

.portfolio img {
  display: block;
  max-width: 100%;
}

/*
   Critical:
   stops the Arrow / External SVGs from becoming gigantic.
*/

.portfolio svg {
  width: 15px;
  height: 15px;

  display: block;

  flex: 0 0 auto;
}

.portfolio h1,
.portfolio h2,
.portfolio h3,
.portfolio p {
  margin-top: 0;
}


/* =========================================================
   SHARED TYPOGRAPHY
   ========================================================= */

.micro-label,
.case-label,
.case-number {
  color: #6e6a61;

  font-family: var(--mono);
  font-size: 10px;
  font-weight: 500;

  letter-spacing: 0.14em;

  text-transform: uppercase;
}

.text-link {
  display: inline-flex;

  align-items: center;

  gap: 13px;

  padding-bottom: 6px;

  border-bottom: 1px solid currentColor;

  font-size: 12px;
  font-weight: 600;

  white-space: nowrap;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.nav {
  position: relative;
  z-index: 100;

  width: var(--page);

  min-height: 96px;

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  margin: 0 auto;

  border-bottom: 1px solid var(--line);
}

.wordmark {
  justify-self: start;

  color: var(--ink);

  font-family: var(--sans);
  font-size: 15px;
  font-weight: 700;

  letter-spacing: 0.12em;
}

.nav nav {
  display: flex;

  align-items: center;

  gap: 34px;
}

.nav nav a {
  position: relative;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 0.07em;

  text-transform: uppercase;
}

.nav nav a::after {
  position: absolute;

  right: 0;
  bottom: -7px;
  left: 0;

  height: 1px;

  content: "";

  background: currentColor;

  transform: scaleX(0);
  transform-origin: right;

  transition: transform 180ms ease;
}

.nav nav a:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

.github-link {
  display: inline-flex;

  justify-self: end;

  align-items: center;

  gap: 8px;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 0.07em;

  text-transform: uppercase;
}

.github-link svg {
  width: 14px;
  height: 14px;
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
  width: var(--page);

  min-height: 760px;

  display: grid;

  grid-template-columns:
    minmax(0, 0.95fr)
    minmax(470px, 0.8fr);

  gap: clamp(60px, 7vw, 120px);

  align-items: center;

  margin: 0 auto;

  padding: 72px 0 90px;
}

.hero-left {
  position: relative;

  z-index: 3;

  min-width: 0;
}

.hero .micro-label {
  margin-bottom: 27px;
}

.hero h1 {
  max-width: 720px;

  margin: 0;

  color: var(--ink);

  font-family: var(--serif);
  font-size: clamp(66px, 6.4vw, 102px);
  font-weight: 400;

  letter-spacing: -0.048em;

  line-height: 0.91;
}

.hero h1 em {
  color: var(--blue);

  font-style: italic;
  font-weight: 400;
}

.hero-bottom {
  display: grid;

  grid-template-columns:
    minmax(0, 470px)
    auto;

  gap: 46px;

  align-items: end;

  margin-top: 58px;
}

.intro {
  margin: 0;

  color: #504e48;

  font-size: 16px;

  line-height: 1.72;
}

.hero-bottom .text-link {
  margin-bottom: 2px;
}


/* =========================================================
   HERO COLLAGE
   ========================================================= */

.hero-collage {
  position: relative;

  min-width: 0;
  min-height: 570px;
}

.marden-preview {
  position: absolute;

  top: 66px;
  right: 0;

  width: min(430px, 84%);
  height: 500px;

  padding: 26px;

  color: #eeece2;
  background: var(--dark);

  box-shadow:
    15px 16px 0 rgba(23, 23, 19, 0.07);

  transform: rotate(1.6deg);
}

.project-index {
  color: #7f8377;

  font-family: var(--mono);
  font-size: 9px;

  letter-spacing: 0.11em;

  text-transform: uppercase;
}

.marden-mark {
  position: absolute;

  top: 50%;
  left: 50%;

  width: 150px;
  height: 150px;

  display: grid;

  place-items: center;

  border: 1px solid rgba(238, 236, 226, 0.33);

  border-radius: 50%;

  font-family: var(--serif);
  font-size: 72px;

  transform: translate(-50%, -53%);
}

.marden-preview-bottom {
  position: absolute;

  right: 26px;
  bottom: 28px;
  left: 26px;

  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;
}

.marden-preview-bottom span {
  display: block;

  margin-bottom: 6px;

  color: #808479;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}

.marden-preview-bottom h2 {
  margin: 0;

  font-family: var(--serif);
  font-size: 42px;
  font-weight: 400;
}

.arrow-circle {
  width: 46px;
  height: 46px;

  display: grid;

  place-items: center;

  border: 1px solid rgba(238, 236, 226, 0.45);

  border-radius: 50%;

  transition:
    transform 180ms ease,
    background-color 180ms ease;
}

.arrow-circle svg {
  width: 17px;
  height: 17px;
}

.arrow-circle:hover {
  background: rgba(255, 255, 255, 0.06);

  transform: translateX(3px);
}


/* yellow sticky */

.paper-note {
  position: absolute;

  z-index: 6;

  padding: 22px 24px;

  color: #24241d;
  background: var(--yellow);

  box-shadow:
    9px 10px 0 rgba(23, 23, 19, 0.08);
}

.note-one {
  top: 10px;
  left: 2px;

  width: 240px;

  transform: rotate(-5deg);
}

.paper-note span {
  display: block;

  margin-bottom: 9px;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.06em;

  text-transform: uppercase;
}

.paper-note strong {
  display: block;

  font-family: var(--serif);
  font-size: 22px;
  font-weight: 400;

  line-height: 1.05;
}


/* SyncBoard mini card */

.mini-card {
  position: absolute;

  z-index: 7;

  width: 190px;
  height: 225px;

  padding: 18px;

  background: var(--blue);

  color: #ffffff;

  box-shadow:
    10px 11px 0 rgba(23, 23, 19, 0.08);
}

.sync-mini {
  bottom: -5px;
  left: -20px;

  transform: rotate(-6deg);
}

.mini-number {
  font-family: var(--mono);
  font-size: 9px;
}

.sync-mini p {
  position: absolute;

  bottom: 14px;
  left: 18px;

  margin: 0;

  font-family: var(--serif);
  font-size: 25px;
}

.sync-symbol {
  position: absolute;

  top: 70px;
  right: 40px;
  left: 40px;

  height: 58px;
}

.sync-symbol span {
  position: absolute;

  width: 68px;
  height: 18px;

  border:
    3px solid
    rgba(255, 255, 255, 0.94);

  border-radius: 999px;
}

.sync-symbol span:first-child {
  top: 5px;
  left: 7px;

  border-left-color: transparent;

  transform: skewX(-15deg);
}

.sync-symbol span:last-child {
  right: 7px;
  bottom: 5px;

  border-right-color: transparent;

  transform: skewX(-15deg);
}

.scribble {
  position: absolute;

  right: -5px;
  bottom: -48px;

  font-family: var(--hand);
  font-size: 21px;
  font-weight: 500;

  line-height: 1;

  transform: rotate(-5deg);
}


/* =========================================================
   MARQUEE
   ========================================================= */

.marquee-line {
  width: 100%;

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);

  overflow: hidden;
}

.marquee-line > div {
  min-width: 100%;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 28px;

  padding: 20px 24px;
}

.marquee-line span {
  flex: 0 0 auto;

  font-family: var(--mono);
  font-size: 10px;

  letter-spacing: 0.12em;
}

.marquee-line i {
  flex: 0 0 auto;

  color: var(--rust);

  font-size: 8px;
  font-style: normal;
}


/* =========================================================
   SELECTED WORK
   ========================================================= */

.work-section {
  padding: 130px 0 145px;
}

.section-heading {
  width: var(--page);

  display: grid;

  grid-template-columns:
    0.42fr
    1fr
    0.46fr;

  gap: 54px;

  align-items: end;

  margin: 0 auto 84px;
}

.section-heading .micro-label {
  margin-bottom: 4px;
}

.section-heading h2 {
  margin: 0;

  font-family: var(--serif);
  font-size: clamp(56px, 5.5vw, 86px);
  font-weight: 400;

  letter-spacing: -0.045em;

  line-height: 0.93;
}

.section-heading h2 em {
  color: var(--blue);

  font-style: italic;
}

.section-side-copy {
  margin: 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.65;
}


/* =========================================================
   PROJECT GRID
   ========================================================= */

.project-grid {
  width: var(--page);

  display: grid;

  grid-template-columns:
    minmax(0, 1.45fr)
    minmax(330px, 0.7fr);

  gap: 24px;

  align-items: start;

  margin: 0 auto;
}

.project-card {
  position: relative;

  min-width: 0;
  overflow: hidden;
}

.project-meta-row {
  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  color: #74786e;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.09em;

  text-transform: uppercase;
}

.project-meta-row span:nth-child(2) {
  text-align: center;
}

.project-meta-row span:last-child {
  text-align: right;
}


/* =========================================================
   MARDEN ROW PROJECT CARD
   ========================================================= */

.project-marden {
  min-height: 640px;

  padding: 30px;

  color: #ebe8de;
  background: var(--dark);
}

.marden-visual {
  position: relative;

  height: 335px;

  margin-top: 20px;
}

.gateway-core {
  position: absolute;

  top: 50%;
  left: 50%;

  z-index: 3;

  width: 160px;
  height: 160px;

  display: grid;

  place-items: center;

  border: 1px solid #757b6f;

  border-radius: 50%;

  transform: translate(-50%, -50%);
}

.gateway-core span {
  font-family: var(--serif);
  font-size: 76px;
}

.gateway-node {
  position: absolute;

  z-index: 3;

  width: 58px;
  height: 58px;

  display: grid;

  place-items: center;

  border: 1px solid #6e7469;

  border-radius: 50%;

  color: #969b91;

  font-family: var(--mono);
  font-size: 9px;
}

.node-one {
  top: 85px;
  left: 10%;
}

.node-two {
  top: 42px;
  right: 7%;
}

.node-three {
  right: 13%;
  bottom: 20px;
}

.gateway-line {
  position: absolute;

  z-index: 1;

  height: 1px;

  background: #50564d;

  transform-origin: left center;
}

.line-a {
  top: 125px;
  left: 17%;

  width: 42%;

  transform: rotate(16deg);
}

.line-b {
  top: 190px;
  left: 19%;

  width: 41%;

  transform: rotate(-22deg);
}

.line-c {
  top: 207px;
  left: 28%;

  width: 46%;

  transform: rotate(27deg);
}

.project-copy {
  display: grid;

  grid-template-columns:
    0.85fr
    1.15fr;

  gap: 44px;

  align-items: start;
}

.project-copy h3 {
  margin: 0;

  font-family: var(--serif);
  font-size: 48px;
  font-weight: 400;

  letter-spacing: -0.035em;

  line-height: 0.95;
}

.project-subtitle {
  margin: 11px 0 0 !important;

  color: #83877e !important;

  font-family: var(--mono);
  font-size: 8px !important;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.project-copy > p {
  margin: 0;

  color: #adafa7;

  font-size: 13px;

  line-height: 1.7;
}

.project-footer {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 30px;

  margin-top: 28px;
  padding-top: 20px;

  border-top: 1px solid rgba(235, 232, 222, 0.22);
}

.plain-stack {
  color: #84887f;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.03em;
}

.project-footer a {
  display: inline-flex;

  align-items: center;

  gap: 10px;

  font-size: 11px;
  font-weight: 600;
}

.project-footer svg {
  width: 14px;
  height: 14px;
}


/* =========================================================
   SYNCBOARD PROJECT
   ========================================================= */

.project-syncboard {
  min-height: 640px;

  padding: 28px;

  color: #171913;
  background: var(--sage);
}

.light-meta {
  color: #646b60;
}

.syncboard-art {
  position: relative;

  height: 330px;

  margin: 18px 0 5px;
}

.phone {
  position: absolute;

  width: 145px;
  height: 275px;

  padding: 30px 16px 16px;

  border: 2px solid #282b24;

  border-radius: 28px;

  background: #f1f0e9;

  box-shadow:
    8px 9px 0 rgba(22, 23, 18, 0.09);
}

.phone-left {
  top: 25px;
  left: 7%;

  transform: rotate(-6deg);
}

.phone-right {
  top: 44px;
  right: 3%;

  transform: rotate(5deg);
}

.phone-bar {
  position: absolute;

  top: 13px;
  left: 50%;

  width: 40px;
  height: 5px;

  border-radius: 999px;

  background: #282b24;

  transform: translateX(-50%);
}

.task-row {
  width: 72%;
  height: 9px;

  margin-bottom: 14px;

  background: #b4baae;
}

.task-row.wide {
  width: 100%;
}

.task-row.small {
  width: 54%;
}

.sync-state {
  position: absolute;

  right: 13px;
  bottom: 22px;
  left: 13px;

  padding: 10px 6px;

  border: 1px solid #929b8b;

  font-family: var(--mono);
  font-size: 7px;

  text-align: center;
}

.conflict-box {
  margin-top: 28px;

  padding: 12px 10px;

  border: 1px solid #ad593f;

  color: #9b4734;
}

.conflict-box span,
.conflict-box small {
  display: block;
}

.conflict-box span {
  margin-bottom: 9px;

  font-family: var(--mono);
  font-size: 7px;
}

.conflict-box small {
  margin-top: 7px;

  font-size: 7px;
}

.sync-orbit {
  position: absolute;

  top: 150px;
  left: 50%;

  z-index: 6;

  color: var(--blue);

  font-size: 38px;
  font-weight: 700;

  transform: translateX(-50%);
}

.light-copy {
  display: block;

  margin-top: 0;
}

.light-copy h3 {
  font-size: 47px;
}

.light-copy > p {
  margin-top: 24px;

  color: #465044;
}

.light-footer {
  border-top-color: rgba(23, 25, 19, 0.16);
}

.light-footer .plain-stack {
  color: #596157;
}


/* =========================================================
   AI MOCK INTERVIEW
   ========================================================= */

.project-interview {
  grid-column: 1;

  width: 62%;

  min-height: 390px;

  margin:
    46px
    0
    0
    13%;

  padding: 30px;

  color: #f6e9dc;
  background: var(--rust);
}

.project-interview .project-meta-row {
  color: #db9b8d;
}

.interview-art {
  min-height: 240px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  padding-top: 10px;
}

.quote-mark {
  font-family: var(--serif);
  font-size: 72px;

  line-height: 0.8;

  opacity: 0.5;
}

.interview-art > p {
  max-width: 440px;

  margin: 0;

  font-family: var(--serif);
  font-size: 29px;

  line-height: 1.05;
}

.voice-bars {
  height: 45px;

  display: flex;

  align-items: center;

  gap: 5px;
}

.voice-bars i {
  width: 2px;

  display: block;

  background: #f5e6d9;
}

.voice-bars i:nth-child(1) {
  height: 15px;
}

.voice-bars i:nth-child(2) {
  height: 30px;
}

.voice-bars i:nth-child(3) {
  height: 20px;
}

.voice-bars i:nth-child(4) {
  height: 42px;
}

.voice-bars i:nth-child(5) {
  height: 32px;
}

.voice-bars i:nth-child(6) {
  height: 22px;
}

.voice-bars i:nth-child(7) {
  height: 13px;
}

.project-copy.compact {
  display: block;
}

.project-copy.compact h3 {
  font-size: 40px;
}

.project-interview .project-subtitle {
  color: #efb0a3 !important;
}


/* =========================================================
   STUDIO NOTE
   ========================================================= */

.studio-note {
  width: 90%;

  align-self: center;

  margin:
    80px
    0
    0
    6%;

  padding: 38px 42px;

  color: #171913;
  background: var(--yellow);

  box-shadow:
    11px 12px 0 rgba(23, 23, 19, 0.07);

  transform: rotate(1.6deg);
}

.studio-note p {
  margin: 0 0 14px;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.06em;

  text-transform: uppercase;
}

.studio-note strong {
  display: block;

  font-family: var(--serif);
  font-size: 31px;
  font-weight: 400;

  line-height: 1.05;
}

.studio-note span {
  display: block;

  margin-top: 28px;

  font-family: var(--hand);
  font-size: 25px;
}


/* =========================================================
   MARDEN ROW CASE STUDY — GLOBAL
   ========================================================= */

.marden-case-study {
  margin-top: 20px;
  padding: 0 max(60px, calc((100vw - 1080px) / 2));

  color: var(--dark-text);
  background: var(--dark);
}

.marden-case-study p {
  color: var(--dark-muted);

  font-size: 13px;

  line-height: 1.7;
}

.marden-case-study .case-label {
  color: #83877c;
}


/* =========================================================
   CASE HEADER
   ========================================================= */

.case-header {
  padding: 82px 0 72px;

  border-bottom: 1px solid var(--dark-line);
}

.case-number {
  margin-bottom: 64px;

  color: #85897f;
}

.case-heading {
  display: grid;

  grid-template-columns:
    1.2fr
    0.55fr;

  gap: 80px;

  align-items: start;
}

.case-heading h2 {
  margin: 0;

  font-family: var(--serif);
  font-size: clamp(55px, 5vw, 78px);
  font-weight: 400;

  letter-spacing: -0.045em;

  line-height: 0.9;
}

.case-heading h2 em {
  color: var(--yellow);

  font-style: normal;
}

.case-intro > span {
  display: block;

  margin-bottom: 16px;

  color: #9b9f95;

  font-family: var(--mono);
  font-size: 9px;

  letter-spacing: 0.1em;

  line-height: 1.5;
}

.case-intro p {
  margin: 0;
}


/* =========================================================
   PROBLEM + SYSTEM MAP
   ========================================================= */

.case-layout {
  display: grid;

  grid-template-columns:
    0.55fr
    1fr;

  gap: 70px;

  align-items: start;

  padding: 80px 0 76px;
}

.case-problem h3 {
  margin: 18px 0 28px;

  font-family: var(--serif);
  font-size: 42px;
  font-weight: 400;

  letter-spacing: -0.025em;

  line-height: 0.95;
}

.case-problem h3 em {
  color: #9aaa8b;

  font-style: normal;
}

.case-problem > p {
  margin-bottom: 15px;
}

.margin-note {
  width: 200px;

  margin-top: 42px;

  padding: 18px;

  color: #1d2119;
  background: var(--yellow);

  box-shadow:
    8px 9px 0 rgba(0, 0, 0, 0.2);

  transform: rotate(-2deg);
}

.margin-note span {
  display: block;

  margin-bottom: 7px;

  font-family: var(--mono);
  font-size: 8px;

  text-transform: uppercase;
}

.margin-note strong {
  display: block;

  font-family: var(--serif);
  font-size: 20px;
  font-weight: 400;

  line-height: 1;
}


/* system board */

.gateway-board {
  min-width: 0;

  padding: 24px;

  color: #34362f;
  background: #d9d4c9;
}

.board-caption {
  display: flex;

  align-items: center;
  justify-content: space-between;

  color: #6b6d65;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.1em;
}

.architecture-map {
  position: relative;

  height: 365px;

  margin: 10px 0 12px;
}

.architecture-client,
.provider,
.architecture-key,
.architecture-credentials {
  position: absolute;

  z-index: 4;

  min-width: 90px;

  padding: 10px;

  border: 1px solid #8b8d85;

  background: rgba(240, 238, 231, 0.45);
}

.architecture-client span,
.provider span,
.architecture-key span,
.architecture-credentials span {
  display: block;

  margin-bottom: 5px;

  color: #7c7f77;

  font-family: var(--mono);
  font-size: 6px;
}

.architecture-client strong,
.provider strong,
.architecture-key strong,
.architecture-credentials strong {
  font-size: 10px;
}

.architecture-client {
  top: 150px;
  left: 0;
}

.architecture-core {
  position: absolute;

  top: 50%;
  left: 50%;

  z-index: 5;

  width: 115px;
  height: 115px;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  color: #ebe8dd;
  background: var(--dark);

  transform: translate(-50%, -50%);
}

.architecture-core small {
  color: #7f8379;

  font-family: var(--mono);
  font-size: 6px;
}

.architecture-core strong {
  margin: 5px 0 1px;

  font-family: var(--serif);
  font-size: 44px;
  font-weight: 400;
}

.architecture-core span {
  font-family: var(--serif);
  font-size: 12px;
}

.provider-one {
  top: 36px;
  right: 4px;
}

.provider-two {
  top: 150px;
  right: -10px;
}

.provider-three {
  right: 18px;
  bottom: 26px;
}

.architecture-key {
  bottom: 22px;
  left: 15px;
}

.architecture-credentials {
  top: 15px;
  left: 28%;
}

.architecture-line {
  position: absolute;

  z-index: 2;

  height: 1px;

  background: #a1a39b;

  transform-origin: left center;
}

.line-client {
  top: 183px;
  left: 85px;

  width: 39%;

  transform: rotate(0deg);
}

.line-provider-one {
  top: 158px;
  left: 53%;

  width: 41%;

  transform: rotate(-33deg);
}

.line-provider-two {
  top: 184px;
  left: 54%;

  width: 39%;
}

.line-provider-three {
  top: 203px;
  left: 53%;

  width: 39%;

  transform: rotate(29deg);
}

.board-footnote {
  margin: 0 !important;

  color: #62645d !important;

  font-size: 11px !important;
}


/* =========================================================
   CASE FEATURE STRIP
   ========================================================= */

.case-features {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  border-top: 1px solid var(--dark-line);
  border-bottom: 1px solid var(--dark-line);
}

.case-features article {
  min-width: 0;

  padding: 28px 20px 30px;

  border-right: 1px solid var(--dark-line);
}

.case-features article:last-child {
  border-right: 0;
}

.case-features article > span {
  color: #74796e;

  font-family: var(--mono);
  font-size: 8px;
}

.case-features h3 {
  margin: 30px 0 13px;

  font-family: var(--serif);
  font-size: 22px;
  font-weight: 400;

  line-height: 1;
}

.case-features p {
  margin: 0;

  font-size: 11px;
}


/* =========================================================
   INSIDE MARDEN ROW
   ========================================================= */

.inside-marden {
  padding: 120px 0 130px;
}

.inside-marden-heading {
  display: grid;

  grid-template-columns:
    0.4fr
    1.15fr
    0.7fr;

  gap: 48px;

  align-items: start;

  margin-bottom: 76px;
}

.inside-marden-heading .case-label {
  margin-top: 8px;
}

.inside-marden-heading h3 {
  margin: 0;

  font-family: var(--serif);
  font-size: clamp(46px, 4.3vw, 67px);
  font-weight: 400;

  letter-spacing: -0.035em;

  line-height: 0.94;
}

.inside-marden-heading h3 em {
  color: var(--yellow);

  font-style: italic;
}

.inside-marden-heading > p:last-child {
  margin-top: 7px;
}


/* screenshots */

.marden-shot {
  margin: 0;
}

.marden-shot-frame {
  overflow: hidden;

  border: 1px solid rgba(238, 235, 225, 0.18);

  background: #080a08;

  box-shadow:
    0 30px 64px rgba(0, 0, 0, 0.28);
}

.marden-shot-frame img {
  width: 100%;
  height: auto;

  transition: transform 400ms ease;
}

.marden-shot:hover img {
  transform: scale(1.006);
}

.marden-shot figcaption {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 30px;

  padding-top: 16px;
}

.marden-shot figcaption span {
  color: #7e8278;

  font-family: var(--mono);
  font-size: 9px;

  letter-spacing: 0.08em;

  white-space: nowrap;
}

.marden-shot figcaption strong {
  max-width: 530px;

  color: #b8bab1;

  font-size: 12px;
  font-weight: 500;

  line-height: 1.6;

  text-align: right;
}


/* hero screenshot */

.marden-shot-hero {
  width: 92%;

  margin-left: auto;
}

.marden-shot-hero .marden-shot-frame {
  transform: rotate(0.25deg);
}


/* comparison */

.marden-shot-compare {
  width: 96%;

  margin-top: 110px;
}

.marden-shot-compare .marden-shot-frame {
  transform: rotate(-0.2deg);
}


/* paired screenshots */

.marden-shot-pair {
  display: grid;

  grid-template-columns:
    0.9fr
    1.1fr;

  gap: 42px;

  align-items: start;

  margin-top: 110px;
}

.marden-shot-developers {
  margin-top: 75px;
}

.marden-shot-developers .marden-shot-frame {
  transform: rotate(-0.5deg);
}

.marden-shot-providers .marden-shot-frame {
  transform: rotate(0.45deg);
}


/* yellow note */

.marden-product-note {
  width: min(520px, 70%);

  margin:
    110px
    5%
    0
    auto;

  padding: 34px 38px;

  color: #171913;
  background: var(--yellow);

  box-shadow:
    13px
    14px
    0 rgba(238, 235, 225, 0.075);

  transform: rotate(-1.25deg);
}

.marden-product-note span {
  display: block;

  margin-bottom: 14px;

  font-family: var(--mono);
  font-size: 9px;

  letter-spacing: 0.07em;
}

.marden-product-note p {
  margin: 0 !important;

  color: #171913 !important;

  font-family: var(--serif);
  font-size: 34px !important;

  letter-spacing: -0.02em;

  line-height: 1.03 !important;
}


/* chat + login */

.marden-shot-pair-bottom {
  grid-template-columns:
    1.25fr
    0.75fr;

  margin-top: 120px;
}

.marden-shot-chat .marden-shot-frame {
  transform: rotate(0.3deg);
}

.marden-shot-login {
  margin-top: 90px;
}

.marden-shot-login .marden-shot-frame {
  background: #f5f5f3;

  transform: rotate(-0.65deg);
}


/* =========================================================
   ENGINEERING STORY
   ========================================================= */

.engineering-spread {
  display: grid;

  grid-template-columns:
    0.72fr
    1fr
    0.55fr;

  gap: 54px;

  align-items: center;

  padding: 80px 0;

  border-top: 1px solid var(--dark-line);
  border-bottom: 1px solid var(--dark-line);
}

.engineering-title h3 {
  margin: 18px 0 0;

  font-family: var(--serif);
  font-size: 43px;
  font-weight: 400;

  line-height: 0.95;
}

.engineering-title h3 em {
  color: #97a889;

  font-style: normal;
}

.engineering-copy p {
  margin-bottom: 14px;
}

.engineering-note {
  padding: 26px 22px;

  color: #192018;
  background: var(--sage);

  transform: rotate(2deg);
}

.engineering-note span {
  display: block;

  margin-bottom: 16px;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.05em;
}

.engineering-note strong {
  display: block;

  font-family: var(--serif);
  font-size: 24px;
  font-weight: 400;

  line-height: 1;
}


/* =========================================================
   CORE STACK
   ========================================================= */

.case-stack {
  min-height: 130px;

  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 40px;

  padding: 28px 0 75px;
}

.case-stack .case-label {
  display: block;

  margin-bottom: 8px;
}

.case-stack p {
  margin: 0;

  font-family: var(--mono);
  font-size: 9px;
}

.case-stack > a {
  display: inline-flex;

  align-items: center;

  gap: 10px;

  margin-top: 20px;
  padding-bottom: 5px;

  border-bottom: 1px solid #d5d2c8;

  font-size: 11px;
  font-weight: 600;
}


/* =========================================================
   CAPABILITIES
   ========================================================= */

.capabilities {
  width: 100%;

  display: grid;

  grid-template-columns:
    0.72fr
    1.28fr;

  gap: 100px;

  padding:
    120px
    max(60px, calc((100vw - 1440px) / 2));

  background: var(--paper-deep);
}

.capabilities-title h2 {
  max-width: 470px;

  margin: 32px 0 0;

  font-family: var(--serif);
  font-size: clamp(52px, 5vw, 72px);
  font-weight: 400;

  letter-spacing: -0.04em;

  line-height: 0.95;
}

.capability-list {
  border-top: 1px solid rgba(23, 23, 19, 0.25);
}

.capability-list article {
  display: grid;

  grid-template-columns:
    55px
    0.8fr
    1.15fr;

  gap: 28px;

  align-items: start;

  padding: 30px 0;

  border-bottom: 1px solid rgba(23, 23, 19, 0.25);
}

.capability-list article > span {
  font-family: var(--mono);
  font-size: 8px;
}

.capability-list h3 {
  margin: 0;

  font-family: var(--serif);
  font-size: 30px;
  font-weight: 400;
}

.capability-list p {
  margin: 0;

  color: #615e57;

  font-size: 12px;

  line-height: 1.65;
}


/* =========================================================
   ABOUT
   ========================================================= */

.about-section {
  width: min(1240px, calc(100% - 120px));

  display: grid;

  grid-template-columns:
    0.4fr
    1.15fr;

  gap: 100px;

  align-items: start;

  margin: 0 auto;

  padding: 150px 0;
}

.about-stamp {
  width: 175px;
  height: 175px;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 13px;

  border: 1px solid var(--ink);

  border-radius: 50%;

  font-family: var(--mono);
  font-size: 8px;

  text-align: center;

  transform: rotate(-5deg);
}

.about-stamp strong {
  color: var(--rust);

  font-size: 24px;
  font-weight: 400;
}

.about-copy .micro-label {
  margin-bottom: 28px;
}

.about-copy h2 {
  margin: 0 0 42px;

  font-family: var(--serif);
  font-size: clamp(58px, 5.7vw, 84px);
  font-weight: 400;

  letter-spacing: -0.042em;

  line-height: 0.92;
}

.about-copy h2 em {
  color: var(--blue);

  font-style: normal;
}

.about-copy > p:not(.micro-label) {
  max-width: 710px;

  margin-bottom: 18px;

  color: #4d4a44;

  font-size: 15px;

  line-height: 1.75;
}


/* =========================================================
   CONTACT
   ========================================================= */

.contact-section {
  width: 100%;

  padding:
    120px
    60px
    125px;

  color: #f5f1e7;
  background: var(--blue);

  text-align: center;
}

.contact-section .micro-label {
  color: rgba(255, 255, 255, 0.68);

  margin-bottom: 34px;
}

.contact-section h2 {
  max-width: 1120px;

  margin: 0 auto 52px;

  font-family: var(--serif);
  font-size: clamp(65px, 7vw, 106px);
  font-weight: 400;

  letter-spacing: -0.045em;

  line-height: 0.89;
}

.contact-section h2 em {
  color: var(--yellow);

  font-style: normal;
}

.contact-row {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 14px;
}

.contact-row a {
  min-width: 130px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 11px;

  padding: 15px 20px;

  border:
    1px solid
    rgba(255, 255, 255, 0.55);

  font-size: 11px;
  font-weight: 600;
}

.contact-primary {
  color: var(--blue) !important;
  background: var(--paper);
}

.contact-row svg {
  width: 14px;
  height: 14px;
}


/* =========================================================
   FOOTER
   ========================================================= */

footer {
  min-height: 70px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 24px;

  padding: 0 32px;

  color: #a6a89e;
  background: #161814;

  font-family: var(--mono);
  font-size: 8px;

  letter-spacing: 0.12em;

  text-transform: uppercase;
}


/* =========================================================
   HOVER DETAILS
   ========================================================= */

.text-link,
.project-footer a,
.case-stack > a,
.github-link,
.contact-row a {
  transition:
    opacity 160ms ease,
    transform 160ms ease;
}

.text-link:hover,
.project-footer a:hover,
.case-stack > a:hover,
.github-link:hover {
  opacity: 0.67;
}

.contact-row a:hover {
  transform: translateY(-2px);
}


/* =========================================================
   RESPONSIVE — 1200
   ========================================================= */

@media (max-width: 1200px) {
  :root {
    --page: calc(100% - 70px);
  }

  .hero {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(400px, 0.78fr);

    gap: 40px;
  }

  .hero h1 {
    font-size: clamp(62px, 6.4vw, 86px);
  }

  .marden-preview {
    width: 390px;
  }

  .sync-mini {
    left: -6px;
  }

  .section-heading {
    grid-template-columns:
      0.35fr
      1fr;
  }

  .section-side-copy {
    grid-column: 2;
  }

  .project-grid {
    grid-template-columns:
      minmax(0, 1.3fr)
      minmax(300px, 0.7fr);
  }

  .marden-case-study {
    padding-right: 50px;
    padding-left: 50px;
  }

  .inside-marden-heading {
    grid-template-columns:
      0.4fr
      1fr;
  }

  .inside-marden-heading > p:last-child {
    grid-column: 2;
  }

  .engineering-spread {
    grid-template-columns:
      0.75fr
      1fr;
  }

  .engineering-note {
    grid-column: 2;
  }

  .capabilities {
    padding-right: 50px;
    padding-left: 50px;

    gap: 70px;
  }
}


