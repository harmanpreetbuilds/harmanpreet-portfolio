   RESPONSIVE — PHONE
   ========================================================= */

@media (max-width: 620px) {
  :root {
    --page: calc(100% - 32px);
  }

  .nav {
    min-height: 72px;

    grid-template-columns:
      1fr
      auto;
  }

  .nav nav {
    display: none;
  }

  .wordmark {
    font-size: 13px;
  }

  .github-link {
    font-size: 9px;
  }

  .hero {
    padding:
      60px
      0
